QDRANT_API_KEY=...
QDRANT_URL=https://your-cluster.qdrant.io:6333

# optional: set to require X-API-Key header on /search and /ws/search. Empty = no auth (default).
API_KEY=

COLLECTION_NAME=stream_search
EMBED_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBED_MODEL=Qdrant/bm25
EMBED_DIM=384

WINDOW_SIZE=10000
WINDOW_SECONDS=86400

KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=stream_search
KAFKA_GROUP_ID=stream_search_consumer

BATCH_SIZE=32
BATCH_FLUSH_MS=500
